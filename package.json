{
  "name": "slint-monorepo",
  "private": true,
  "description": "Monorepo for the slint Agent Skills linter (CLI, VS Code extension, docs).",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build:cli": "turbo run build --filter=slint-cli",
    "test:cli": "cargo test --workspace",
    "lint:cli": "turbo run lint --filter=slint-cli",
    "format:cli": "pnpm --filter slint-cli format",
    "build:vscode": "turbo run build --filter=slint-vscode",
    "package:vscode": "turbo run build --filter=slint-vscode && pnpm --filter slint-vscode package",
    "dev:docs": "turbo run dev --filter=slint-docs",
    "build:docs": "turbo run build --filter=slint-docs",
    "sync:docs": "pnpm --filter slint-docs sync"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
